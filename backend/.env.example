# LiveKit server/cloud connection
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Room the bots join by default in dev
ROXROOM_ROOM_NAME=roxroom-dev

# Bot identities/display names (must appear as real named participants)
ROXROOM_DOST_IDENTITY=roxstar-ai-dost
ROXROOM_DOST_NAME=Roxstar AI Dost
ROXROOM_SATHI_IDENTITY=roxstar-ai-sathi
ROXROOM_SATHI_NAME=Roxstar AI Sathi

# --- Providers (wired up in later milestones, not used by M0) ---
# STT
SARVAM_API_KEY=
DEEPGRAM_API_KEY=

# LLM -- Groq is what run_bot.py actually uses (llama-3.3-70b-versatile /
# llama-3.1-8b-instant). OPENAI_API_KEY / ANTHROPIC_API_KEY are only needed if you
# switch bots/providers/groq_llm.py back to openai_llm.py / anthropic_llm.py in
# run_bot.py -- all three implement the same interface.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# TTS
SARVAM_TTS_API_KEY=
SMALLEST_API_KEY=
ELEVENLABS_API_KEY=
# ElevenLabs voice IDs -- pick real ones from https://elevenlabs.io/app/voice-library
# (personas/*.yaml document Sarvam as the production choice; ElevenLabs is what's
# actually wired up for the runnable M4 demo -- see bots/providers/sarvam_tts.py)
ELEVENLABS_DOST_VOICE_ID=
ELEVENLABS_SATHI_VOICE_ID=
